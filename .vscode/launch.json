  "version": "0.2.0",
  "configurations": [
    
   {
      "name": "Debug Python MongoDB Docker",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/main.py",
      "console": "integratedTerminal",
      "python": "${workspaceFolder}/../venv/bin/python",
      "preLaunchTask": "prepare-environment", 
      "postDebugTask": "docker-compose-mongodb-down"
    },
    {
      "name": "Debug MyPlayer container",
      "type": "debugpy",
      "request": "attach",
      "connect": {
          "host": "localhost",
          "port": 5678
      },
      "pathMappings": [
          {
              "localRoot": "/home/fredele/MyPlayer/player",
              "remoteRoot": "/home/player/MyPlayer/player"
          }
      ]
    }
   
  ]
}