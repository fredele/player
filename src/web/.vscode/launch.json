{
  // Utilisez IntelliSense pour en savoir plus sur les attributs possibles.
  // Pointez pour afficher la description des attributs existants.
  // Pour plus d'informations, visitez : https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "type": "firefox",
      "request": "launch",
      "name": "Debug with firefox",
      "url": "http://localhost:8000",
      "webRoot": "${workspaceFolder}",
      "firefoxArgs": [
        "--devtools"
      ],
      "profile": "default",
      "pathMappings": [
        {
          "url": "http://localhost:8000",
          "path": "${workspaceFolder}/static"
        },
        {
          "url": "http://localhost:8000/js/browse.js",
          "path": "${workspaceFolder}/static/js/browse.js"
        },
        {
          "url": "http://localhost:8000/js/browse_web.js",
          "path": "${workspaceFolder}/static/js/browse_web.js"
        },
        {
          "url": "http://localhost:8000/js/browser_cordova.js",
          "path": "${workspaceFolder}/static/js/browser_cordova.js"
        },
        {
          "url": "http://localhost:8000/js/browse_players.js",
          "path": "${workspaceFolder}/static/js/browse_players.js"
        },
        {
          "url": "http://localhost:8000/js/vars.js",
          "path": "${workspaceFolder}/static/js/vars.js"
        }
      ]
    }
  ]
}